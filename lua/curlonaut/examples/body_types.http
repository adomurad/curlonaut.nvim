@baseUrl = http://localhost:3000/api

### JSON response body

GET {{baseUrl}}/json

### HTML response body

GET {{baseUrl}}/html

### XML response body

GET {{baseUrl}}/xml

### plain text response body

GET {{baseUrl}}/text

### query params

GET {{baseUrl}}/echo
 ?username=john
 &password=pass
 &age=30

### query params - omit

@t5={{$omit}}
# @t5=wowowowo

GET {{baseUrl}}/echo
 ?username=john
 &password={{t5}}
 &age=30

### application/json request body

POST {{baseUrl}}/accept-json
Content-Type: application/json

{
  "messageInBody": "message from body",
  "aNumber": 12345,
  "bool": true
}

### www-urlencoded request body

POST {{baseUrl}}/accept-urlencoded
Content-Type: application/x-www-form-urlencoded

username=jo

hn&password=secret&age=30

### www-urlencoded request body - strip new lines

POST {{baseUrl}}/accept-urlencoded
Content-Type: application/x-www-form-urlencoded

username=john
&password=secret
&age=30

### www-urlencoded request body - omit a field

POST {{baseUrl}}/accept-urlencoded
Content-Type: application/x-www-form-urlencoded

username=john
&password={{$omit}}
&age=30

### multipart request body

POST {{baseUrl}}/accept-multipart
Content-Type: multipart/form-data

username=john
password=secret
file=< ./env.http

### multipart request body - with custom type

POST {{baseUrl}}/accept-multipart
Content-Type: multipart/form-data

username=john
password=secret
file=< ./env.http

### multipart request body - wrong file

POST {{baseUrl}}/accept-multipart
Content-Type: multipart/form-data

username=john
password=secret
file=< ./fakefakefile.http

### multipart request body - omit a field

POST {{baseUrl}}/accept-multipart
Content-Type: multipart/form-data

username=john
password={{$omit}}
file=< ./env.http

