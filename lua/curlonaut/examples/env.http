# @env-file ./.env.local

@baseUrl = http://localhost:3000/api

### show warning when empty var

POST {{baseUrl}}/echo
Content-Type: application/json
Authorization: Bearer {{EMPTY_HEADER}}
X-Custom-Header: test
X-Custom-Header2: test

{
  "body": 5,
  "token": "{{EMPTY_BODY}}"
}

### Use var from env-file

POST {{baseUrl}}/echo
Content-Type: application/json
Authorization: Bearer {{TEST_TOKEN_CURLONAUT}}
X-Custom-Header: test
X-Custom-Header2: test

{
  "body": 5,
  "token": "{{TEST_TOKEN_CURLONAUT}}"
}

### Use var from environment

POST {{baseUrl}}/echo
Content-Type: application/json

{
  "shellUser": "{{USER}}"
}

### Use var from env-file (override environment)

@TEST_TOKEN_OVERRIDE = inline-overridden-value

POST {{baseUrl}}/echo
Content-Type: application/json

{
  "token": "{{TEST_TOKEN_OVERRIDE}}",
  "home": "{{HOME}}"
}
